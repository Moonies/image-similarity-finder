# Stage 1: Base image for setting up the working directory and package files
FROM node:22.3 AS base
WORKDIR /app
# Copy only package files to ensure that dependency installation is cached separately
COPY package*.json ./

# Stage 2: Install dependencies using a deterministic installation process
FROM base AS deps
# Using 'npm ci' ensures that dependencies are installed exactly as specified in package-lock.json
RUN npm ci

# Stage 3: Build the application
FROM deps AS builder
# Copy the remainder of the source code; this layer will be rebuilt only if your code changes
COPY . .
RUN npm run build

RUN ls -la /app

# Stage 4: Create the production image
FROM node:22.3-slim AS production
WORKDIR /app
# Copy the installed dependencies from the 'deps' stage
COPY --from=deps /app/node_modules ./node_modules
# Copy the build output from the 'builder' stage
COPY --from=builder /app/dist ./dist
# If your application requires additional files (e.g., configuration), copy them here.
EXPOSE 3000
CMD [ "npm", "run", "start" ]
